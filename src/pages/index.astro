---
const title = "Pangsit Mania - Pangsit Gurih, Bikin Nagih";

const waLinkTanya = "https://wa.me/628132218594?text=Halo%20saya%20mau%20tanya%20tentang%20pangsit-mania!";
const waLinkMitra = "https://wa.me/628132218594?text=Halo%20saya%20mau%20jadi%20mitra!";

const shopeeFrozen = "https://id.shp.ee/8TwjRqZA";
const shopeeFood = "https://shopee.co.id/universal-link/now-food/shop/23421323?deep_and_deferred=1&shareChannel=copy_link";
const gofood = "https://gofood.link/a/SHpXoq9";
const grabfood = "https://r.grab.com/g/2-1-6-C8CWC34XMFE2NN";

import '../styles/global.css';
---

<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>
<body class="bg-amber-50/30 text-gray-900 font-sans antialiased">

  <!-- NAVBAR STICKY -->
  <nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100 py-3 px-4 md:px-8 flex justify-between items-center">
    <div class="flex items-center gap-3">
      <img src="assets/pangsit-mania-logo.webp" alt="Logo Pangsit Mania" class="w-10 h-10 rounded-full shadow" />
      <span class="font-extrabold text-lg text-red-600 tracking-tight">PANGSIT MANIA</span>
    </div>
    <a href={waLinkTanya} target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs md:text-sm px-4 py-2 rounded-full transition">
      💬 Tanya WA
    </a>
  </nav>

  <!-- 1. HERO SECTION -->
  <section class="max-w-6xl mx-auto px-4 py-12 md:py-20 grid md:grid-cols-2 gap-8 items-center">
    <div class="space-y-6">
      <span class="bg-red-100 text-red-700 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider">Antapani, Bandung</span>
      <h1 class="text-4xl md:text-6xl font-black text-gray-900 leading-tight">
        Pangsit Gurih, <br/><span class="text-red-600">Bikin Nagih. 🥟</span>
      </h1>
      <p class="text-gray-600 text-base md:text-lg">
        Pangsit nikmat dengan pilihan rasa istimewa. Siap dinikmati langsung matang hangat atau disimpan stok frozen di rumah.
      </p>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <a href="#pesan-matang" class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3.5 rounded-xl text-center shadow-lg shadow-red-200 transition">
          🔥 Pesan Pangsit Matang
        </a>
        <a href={shopeeFrozen} target="_blank" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-6 py-3.5 rounded-xl text-center shadow-lg shadow-amber-100 transition">
          ❄️ Beli Pangsit Frozen
        </a>
      </div>

      <p class="text-xs text-gray-500 font-medium pt-1">
        ✓ Matang • ✓ Frozen • ✓ Untuk Dinikmati & Dijual Kembali
      </p>
    </div>

    <!-- Visual Hero Image -->
    <div class="relative">
      <img src="assets/pangsit-goreng.webp" alt="Pangsit Goreng Ayam Mozza" class="rounded-3xl shadow-2xl w-full object-cover aspect-square" />
      <div class="absolute -bottom-4 -left-4 bg-white p-4 rounded-2xl shadow-xl border border-gray-100 flex items-center gap-3">
        <span class="text-2xl">🧀</span>
        <div>
          <p class="font-bold text-sm">Mozzarella Lumer</p>
          <p class="text-xs text-gray-500">Kriuk di luar, juicy di dalam</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. KENALAN SECTION -->
  <section class="bg-[#E53935] text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center space-y-4">
      <h2 class="text-2xl md:text-4xl font-extrabold">Kenalan dengan Pangsit Mania</h2>
      <p class="text-red-100 text-base md:text-lg leading-relaxed max-w-2xl mx-auto">
        Hadir untuk menghadirkan pangsit praktis, gurih, dan punya ragam pilihan rasa untuk segala momen harianmu.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-6">
        <div class="bg-white/10 backdrop-blur p-4 rounded-xl border border-white/20">
          <p class="font-bold">Mau langsung makan?</p>
          <p class="text-xs text-red-100 mt-1">Ada varian hangat matang siap santap.</p>
        </div>
        <div class="bg-white/10 backdrop-blur p-4 rounded-xl border border-white/20">
          <p class="font-bold">Mau stok di rumah?</p>
          <p class="text-xs text-red-100 mt-1">Kemasan frozen aman & praktis.</p>
        </div>
        <div class="bg-white/10 backdrop-blur p-4 rounded-xl border border-white/20">
          <p class="font-bold">Mau menjual kembali?</p>
          <p class="text-xs text-red-100 mt-1">Tersedia program kemitraan B2B.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PRODUK SIGNATURE -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="text-center space-y-2 mb-12">
      <h2 class="text-3xl font-extrabold">Pilih Pangsit Signature Favoritmu</h2>
      <p class="text-gray-500">Dibuat dari bahan pilihan dengan isian berdaging tebal</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      <!-- Card Produk 1 -->
      <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 flex flex-col justify-between">
        <img src="assets/pangsit-goreng.webp" alt="Ayam Mozza" class="rounded-xl w-full h-36 md:h-48 object-cover mb-3" />
        <div>
          <h3 class="font-bold text-gray-800">Ayam Mozzarella</h3>
          <p class="text-xs text-gray-500 mt-1">Gurihnya ayam berpadu mozzarella lumer.</p>
        </div>
      </div>
      <!-- Card Produk 2 -->
      <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 flex flex-col justify-between">
        <img src="assets/pangsit-rebus.webp" alt="Ayam Bawang" class="rounded-xl w-full h-36 md:h-48 object-cover mb-3" />
        <div>
          <h3 class="font-bold text-gray-800">Ayam Bawang</h3>
          <p class="text-xs text-gray-500 mt-1">Aroma bawang harum lembut di setiap gigitan.</p>
        </div>
      </div>
      <!-- Card Produk 3 -->
      <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 flex flex-col justify-between">
        <img src="assets/pangsit-goreng.webp" alt="Ayam Pedas" class="rounded-xl w-full h-36 md:h-48 object-cover mb-3" />
        <div>
          <h3 class="font-bold text-gray-800">Ayam Pedas</h3>
          <p class="text-xs text-gray-500 mt-1">Sensasi gurih pedas pas yang bikin merem melek.</p>
        </div>
      </div>
      <!-- Card Produk 4 -->
      <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 flex flex-col justify-between">
        <img src="assets/pangsit-rebus.webp" alt="Ayam Jamur" class="rounded-xl w-full h-36 md:h-48 object-cover mb-3" />
        <div>
          <h3 class="font-bold text-gray-800">Ayam Jamur</h3>
          <p class="text-xs text-gray-500 mt-1">Kombinasi tekstur jamur dan daging ayam juicy.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. DUA CARA MENIKMATI -->
  <section id="pesan-matang" class="max-w-6xl mx-auto px-4 py-12">
    <div class="bg-amber-100/50 rounded-3xl p-6 md:p-10 border border-amber-200">
      <h2 class="text-2xl md:text-3xl font-black text-center mb-8">Mau Langsung Makan atau Stok di Rumah?</h2>
      
      <div class="grid md:grid-cols-2 gap-6">
        <!-- MATANG CARD -->
        <div class="bg-white rounded-2xl p-6 shadow-sm flex flex-col justify-between">
          <div>
            <div class="inline-block p-3 bg-red-100 rounded-xl text-red-600 mb-4">🔥</div>
            <h3 class="text-xl font-bold">PANGSIT MATANG</h3>
            <p class="text-xs font-semibold text-red-600 mb-2">Goreng / Rebus • Sajikan • Nikmati</p>
            <p class="text-sm text-gray-600 mb-6">Lagi pengen makan pangsit tanpa repot? Pesan hangat siap makan via ojek online favoritmu.</p>
          </div>
          <div class="space-y-2">
            <a href={gofood} target="_blank" class="block w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-lg text-center text-sm transition">Pesan via GoFood</a>
            <a href={grabfood} target="_blank" class="block w-full bg-green-500 hover:bg-green-600 text-white font-bold py-2.5 rounded-lg text-center text-sm transition">Pesan via GrabFood</a>
            <a href={shopeeFood} target="_blank" class="block w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-2.5 rounded-lg text-center text-sm transition">Pesan via ShopeeFood</a>
          </div>
        </div>

        <!-- FROZEN CARD -->
        <div class="bg-white rounded-2xl p-6 shadow-sm flex flex-col justify-between">
          <div>
            <div class="inline-block p-3 bg-blue-100 rounded-xl text-blue-600 mb-4">❄️</div>
            <h3 class="text-xl font-bold">PANGSIT FROZEN</h3>
            <p class="text-xs font-semibold text-blue-600 mb-2">Stok di Freezer • Masak Kapan Saja</p>
            <p class="text-sm text-gray-600 mb-6">Cocok untuk stok camilan atau makanan praktis keluarga di rumah. Tinggal goreng/rebus beberapa menit!</p>
          </div>
          <a href={shopeeFrozen} target="_blank" class="block w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-lg text-center text-sm transition">
            🛍️ Beli Frozen di Shopee
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. KENAPA PANGSIT MANIA -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-2xl md:text-3xl font-extrabold text-center mb-10">Kenapa Harus Pangsit Mania?</h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      <div class="p-5 bg-white rounded-xl border border-gray-100">
        <span class="text-3xl">🥟</span>
        <h3 class="font-bold mt-3">Pilihan Rasa</h3>
        <p class="text-xs text-gray-500 mt-1">Beragam varian isian nikmat yang pas untuk berbagai selera.</p>
      </div>
      <div class="p-5 bg-white rounded-xl border border-gray-100">
        <span class="text-3xl">🔥</span>
        <h3 class="font-bold mt-3">Sangat Praktis</h3>
        <p class="text-xs text-gray-500 mt-1">Bisa langsung dinikmati hangat atau dimasak sendiri dari freezer.</p>
      </div>
      <div class="p-5 bg-white rounded-xl border border-gray-100">
        <span class="text-3xl">❄️</span>
        <h3 class="font-bold mt-3">Bisa Jadi Stok</h3>
        <p class="text-xs text-gray-500 mt-1">Awet disimpan di freezer tanpa merusak kualitas rasa.</p>
      </div>
      <div class="p-5 bg-white rounded-xl border border-gray-100">
        <span class="text-3xl">🤝</span>
        <h3 class="font-bold mt-3">Peluang Usaha</h3>
        <p class="text-xs text-gray-500 mt-1">Terbuka lebar untuk kemitraan cafe, kantin, dan reseller.</p>
      </div>
    </div>
  </section>

  <!-- 6. B2B / MITRA -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="bg-gray-900 text-white rounded-3xl p-8 md:p-12 text-center md:flex md:justify-between md:items-center">
      <div class="md:text-left mb-6 md:mb-0 max-w-xl">
        <h2 class="text-2xl font-bold">Punya Toko atau Ingin Jualan Pangsit?</h2>
        <p class="text-gray-400 text-sm mt-2">Pangsit Mania membuka peluang kerja sama mitra untuk Toko, Warung, Kedai, Kantin, Cafe, hingga Reseller.</p>
      </div>
      <a href={waLinkMitra} target="_blank" class="inline-block bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-6 py-3.5 rounded-xl transition">
        📲 Tanya Program Mitra
      </a>
    </div>
  </section>

  <!-- 7. FOOTER -->
  <footer class="border-t border-gray-200 py-10 bg-white">
    <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-3">
        <img src="assets/pangsit-mania-logo.webp" alt="Logo" class="w-10 h-10 rounded-full" />
        <div>
          <p class="font-bold text-gray-900">PANGSIT MANIA</p>
          <p class="text-xs text-gray-500">Antapani, Bandung • Jam Operasional: 09.00 - 15.00 WIB</p>
        </div>
      </div>
      <div class="flex gap-4 text-xs font-semibold text-gray-600">
        <a href="https://instagram.com/pangsit_mania" target="_blank" class="hover:text-red-600">Instagram @pangsit_mania</a>
        <a href="https://tiktok.com/@pangsit_mania" target="_blank" class="hover:text-red-600">TikTok @pangsit_mania</a>
        <a href={waLinkTanya} target="_blank" class="hover:text-emerald-600">WhatsApp</a>
      </div>
    </div>
  </footer>

</body>
</html>